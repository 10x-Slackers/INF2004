{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build",
            "type": "shell",
            "command": "make -j8",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "Build (tests)",
            "type": "shell",
            "command": "make TEST=1 -j8",
            "group": "build",
            "problemMatcher": "$gcc"
        },
        {
            "label": "Build (crash report)",
            "type": "shell",
            "command": "make CRASH_REPORT=1 -j8",
            "group": "build",
            "problemMatcher": "$gcc"
        },
        {
            "label": "Clean",
            "type": "shell",
            "command": "make clean",
            "problemMatcher": []
        },
        {
            "label": "Flash",
            "type": "shell",
            "command": "picotool load -v -x build/smp1-usb_cdc-cyw43-none-mqtt0-crash0-test0/mtk3pico_smp1_usb_cdc_wifi.uf2",
            "dependsOn": "Build",
            "problemMatcher": []
        }
    ]
}
