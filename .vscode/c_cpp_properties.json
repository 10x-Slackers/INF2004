{
  "version": 4,
  "configurations": [
    {
      "name": "MicroT RP2040",
      "compilerPath": "arm-none-eabi-gcc",
      "intelliSenseMode": "gcc-arm",
      "cStandard": "c99",
      "includePath": [
        "${workspaceFolder}/include",
        "${workspaceFolder}/config",
        "${workspaceFolder}/kernel/knlinc",
        "${workspaceFolder}/app_program",
        "${workspaceFolder}/lib/libtm/sysdepend/pico_rp2040/usb",
        "${workspaceFolder}/lib/libwifi/sysdepend/pico_rp2040"
      ],
      "defines": [
        "_PICO_RP2040_",
        "CNF_SMP=1",
        "TM_CONSOLE_USB_CDC=1",
        "TM_WIFI_CYW43=1",
        "APP_TEST=0",
        "NDEBUG"
      ],
      "compilerArgs": [
        "-mcpu=cortex-m0plus",
        "-mthumb",
        "-mfloat-abi=soft",
        "-ffreestanding"
      ]
    }
  ]
}
